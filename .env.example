# GitHub Pages subpath (production build) — ไม่ต้องตั้งตอน npm run dev
# VITE_BASE_PATH=/crpao-meetingroom/

# Firebase (Web app config — จาก Firebase Console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Telegram (ไม่บังคับ — ถ้าไม่ตั้ง ระบบจะไม่ส่งแจ้งเตือน)
# Chat ID จาก getUpdates ของบอทตัวเดียวกัน (กลุ่ม รายงานห้องประชuม อบจ.ชร. = -5196162591)
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=

# Super Admin ตอน build (อีเมลคั่นด้วย comma / ; / ขึ้นบรรทัด)
# เพิ่ม Super Admin ภายหลังได้ที่ Firestore appConfig/access ฟิลด์ superAdminEmails
# หรือเมนู กำหนดสิทธิ์ Admin > Super Admin (ไม่ต้อง deploy ใหม่)
VITE_SUPER_ADMIN_EMAILS=

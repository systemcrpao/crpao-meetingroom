rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() ? request.auth.token.email.lower() : '';
    }

    function adminUserPath() {
      return /databases/$(database)/documents/adminUsers/$(userEmail());
    }

    function adminUserExists() {
      return signedIn() && exists(adminUserPath());
    }

    function adminRole() {
      return adminUserExists() ? get(adminUserPath()).data.role : '';
    }

    function isAdminUser() {
      return adminRole() in ['admin', 'super_admin'];
    }

    // ผู้ดูแลใน UI (รวม Super Admin จาก appConfig ที่ยังไม่มี adminUsers)
    function canOperateAsAdmin() {
      return isAdminUser() || isListedSuperAdmin();
    }

    function isOfficialPrintCounterId(id) {
      return id.matches('officialPrint_[0-9]+');
    }

    function isSuperAdminUser() {
      return adminRole() == 'super_admin';
    }

    function accessConfigPath() {
      return /databases/$(database)/documents/appConfig/access;
    }

    function superAdminEmailList() {
      return exists(accessConfigPath())
        ? get(accessConfigPath()).data.get('superAdminEmails', [])
        : [];
    }

    function isListedSuperAdmin() {
      return signedIn() && userEmail() in superAdminEmailList();
    }

    function superAdminListIsEmpty() {
      return !exists(accessConfigPath()) || superAdminEmailList().size() == 0;
    }

    function canManageAsSuperAdmin() {
      return isSuperAdminUser() || isListedSuperAdmin();
    }

    // สร้างเอกสาร adminUsers ของตัวเองครั้งแรก (Super Admin จาก env / ยังไม่มีใน Firestore)
    // จำกัดเฉพาะ create — บัญชี Auth ต้องล็อกอินแล้ว (ไม่เปิดให้สมัครสาธารณะ)
    function selfCreateSuperAdmin() {
      return signedIn()
        && userEmail() != ''
        && docId == userEmail()
        && !adminUserExists()
        && request.resource.data.role == 'super_admin'
        && request.resource.data.get('email', '').lower() == userEmail();
    }

    function publicReservationUpdate() {
      return resource.data.status == request.resource.data.status
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['room', 'date', 'startTime', 'endTime'])
          )
          || (
            resource.data.status == 'approved'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['changeRequest', 'changeRequestedAt'])
            && request.resource.data.changeRequest.type in ['edit', 'cancel']
          )
        );
    }

    function validNewReservation() {
      let d = request.resource.data;
      return d.status == 'pending'
        && d.trackingNumber is string
        && d.trackingNumber.size() >= 4
        && d.room is string
        && d.date is string
        && d.startTime is string
        && d.endTime is string;
    }

    function validBookingFeedback() {
      let d = request.resource.data;
      return d.trackingNumber is string && d.trackingNumber.size() >= 4;
    }

    match /reservations/{docId} {
      allow read: if true;
      allow create: if validNewReservation();
      allow update: if canOperateAsAdmin() || publicReservationUpdate();
      allow delete: if canOperateAsAdmin() || resource.data.status == 'pending';
    }

    match /bookingFeedback/{docId} {
      allow read: if canOperateAsAdmin();
      allow create: if validBookingFeedback();
      allow update, delete: if canManageAsSuperAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageAsSuperAdmin();
    }

    match /meetingRooms/{docId} {
      allow read: if true;
      allow create, update, delete: if canManageAsSuperAdmin();
    }

    match /adminUsers/{docId} {
      allow read: if signedIn()
        && (docId == userEmail() || canManageAsSuperAdmin());
      allow create: if canManageAsSuperAdmin() || selfCreateSuperAdmin();
      allow update: if canManageAsSuperAdmin();
      allow delete: if canManageAsSuperAdmin();
    }

    match /appConfig/{docId} {
      allow read: if docId == 'access'
        || (signedIn() && canOperateAsAdmin() && isOfficialPrintCounterId(docId));

      allow create, update: if docId == 'access' && (
        canManageAsSuperAdmin()
        || (signedIn() && isListedSuperAdmin())
        || (signedIn() && superAdminListIsEmpty())
        || (signedIn() && !exists(accessConfigPath()))
      );

      allow create, update: if isOfficialPrintCounterId(docId) && canOperateAsAdmin();

      allow delete: if docId == 'access' && canManageAsSuperAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
